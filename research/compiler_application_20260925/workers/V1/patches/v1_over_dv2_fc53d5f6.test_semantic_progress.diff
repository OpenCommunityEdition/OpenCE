+    before = copy.deepcopy(report)
+    notes = verifier.apply_semantic_data_matches(
+        report, Path(root), Path(root) / "semantic_data_matches.json",
+        Path(root) / "objdiff.json", Path(root) / "symbols.json")
+    return notes, report, before
