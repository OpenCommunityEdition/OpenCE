+def _swap_symbol_offsets(section, first, second):
+    values = {name: value for name, value, _ in section["symbols"]}
+    for item in section["symbols"]:
+        if item[0] == first:
+            item[1] = values[second]
+        elif item[0] == second:
+            item[1] = values[first]
+
