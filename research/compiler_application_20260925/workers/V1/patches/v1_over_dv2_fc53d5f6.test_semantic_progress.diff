+def _v1_section(name, raw, flags, symbols, relocs=(), selection=0):
+    return {
+        "name": name, "raw": bytes(raw), "flags": flags,
+        "symbols": [list(item) for item in symbols],
+        "relocs": [list(item) for item in relocs], "selection": selection,
+    }
