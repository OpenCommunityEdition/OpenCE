+    "_min": 0x2014, "_max": 0x2018, _ABC: 0x3000, "_const_table": 0x3008,
+    _HELLO: 0x3018, _W: 0x3020, _XYZ: 0x5000, "_ext_function": 0x6000,
+    "_other_function": 0x6100, "_bss_var": 0x7000, _REAL: 0x5100,
