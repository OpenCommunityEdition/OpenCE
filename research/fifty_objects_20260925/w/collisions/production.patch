+/* valid_real_plane3d is an inline helper: January inlines it at one collision_move_point
+   assert and calls it out of line at another without treating the plane as escaping, so its
+   body must be visible here; the broad real_math.h keeps only the prototype (declaration-count
+   sensitivity, see above). */
+__inline boolean valid_real_plane3d(
+	real_plane3d const *plane)
+{
+	return
+		valid_real_normal3d(&plane->n) &&
+		valid_real(plane->d);
+}
