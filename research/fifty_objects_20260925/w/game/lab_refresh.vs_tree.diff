+
+struct network_game_server;
+struct network_game_server *global_network_game_server_get(void);
+void network_game_server_change_game_variant(struct network_game_server *server, struct game_variant *variant);
+
+static void lab_setter_refresh(
+	struct game_variant *variant)
+{
+	if (!variant)
+	{
+		csmemset(&game_variant_global, 0, sizeof(game_variant_global));
+	}
+	else
+	{
+		struct network_game_server *server;
+
+		game_variant_global = *variant;
+		server = global_network_game_server_get();
+		if (server)
+			network_game_server_change_game_variant(server, variant);
+	}
+
+	return;
+}
+
+void lab_refresh_one_local(
+	const char *name)
+{
+	struct game_variant variant;
+
+	game_engine_get_variant_by_name(&variant, name);
+	lab_setter_refresh(&variant);
+
+	return;
+}
+
+void lab_refresh_two_local(
+	const char *name)
+{
+	struct game_variant variant;
+	struct game_variant temporary_variant;
+
+	variant = *game_engine_get_variant_by_name(&temporary_variant, name);
+	lab_setter_refresh(&variant);
+
+	return;
+}
