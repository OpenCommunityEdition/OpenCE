+/*
+ITEM_COLLECTION_DEFINITIONS.H
+
+Item collection ('itmc') tag layout, as recorded by the HCEX PDB.  The tag
+group constant lives with the item definitions in ITEM_DEFINITIONS.H.
+Focused owner header: adding these types to the broad ITEM_DEFINITIONS.H
+moves distant declaration-count ties.
+*/
+
+#ifndef __ITEM_COLLECTION_DEFINITIONS_H
+#define __ITEM_COLLECTION_DEFINITIONS_H
+#pragma once
+
+/* ---------- headers */
+
+#include "items/item_definitions.h"
+
+/* ---------- macros */
+
+#define item_collection_definition_get(index) ((struct item_collection_definition *)tag_get(ITEM_COLLECTION_DEFINITION_TAG, index))
+
+/* ---------- structures */
+
+struct item_permutation_definition
+{
+	long unused1[8];
+	real weight;
+	struct tag_reference item;
+	long unused2[8];
+};
+
+struct item_collection_definition
+{
+	struct tag_block permutations;
+	short spawn_time;
+	short pad;
+	long unused[19];
+};
+
+#endif // __ITEM_COLLECTION_DEFINITIONS_H
diff --git a/source/scenario/scenario_netgame_definitions.h b/source/scenario/scenario_netgame_definitions.h
new file mode 100644
index 00000000..e4b0c063
--- /dev/null
+++ b/source/scenario/scenario_netgame_definitions.h
@@ -0,0 +1,55 @@
+/*
+SCENARIO_NETGAME_DEFINITIONS.H
+
+Narrow cross-translation-unit interface to the scenario tag's multiplayer
+blocks (netgame flags, netgame equipment and starting equipment), used by the
+multiplayer game engines.  Member names and layouts follow the HCEX PDB
+records; SCENARIO_DEFINITIONS.H keeps the enclosing struct scenario.
+Focused owner header: adding these types to the broad
+SCENARIO_DEFINITIONS.H moves distant declaration-count ties.
+*/
+
+#ifndef __SCENARIO_NETGAME_DEFINITIONS_H
+#define __SCENARIO_NETGAME_DEFINITIONS_H
+#pragma once
+
+/* ---------- headers */
+
+#include "math/real_math.h"
+#include "tag_files/tag_groups.h"
+
+/* ---------- structures */
+
+struct scenario_netgame_flag
+{
+	real_point3d position;
+	real facing;
+	short type;
+	short team_index;
+	long unused[32];
+};
+
+struct scenario_netgame_equipment
+{
+	long flags;
+	short game_type[4];
+	short team_index;
+	short spawn_time;
+	long run_time_spawned_item_index;
+	long unused1[11];
+	real_point3d position;
+	real facing;
+	struct tag_reference item_collection;
+	long unused2[12];
+};
+
+struct scenario_starting_equipment
+{
+	long flags;
+	short game_type[4];
+	long unused1[12];
+	struct tag_reference item_collection[6];
+	long unused2[12];
+};
+
+#endif // __SCENARIO_NETGAME_DEFINITIONS_H
