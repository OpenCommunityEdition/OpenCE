+/* ---------- public code */
+
+__inline short check_stack_buffer(
+	long *buffer)
+{
+	short index;
+
+	for (index = STACK_BUFFER_LENGTH-1; index>=0; index--)
+	{
+		if (buffer[index]!=STACK_BUFFER_FILL)
+			return index;
+	}
+
+	return NONE;
+}
