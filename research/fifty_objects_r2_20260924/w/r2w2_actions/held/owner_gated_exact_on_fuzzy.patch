 /* ---------- macros */
 
+/* INFERRED FROM JANUARY'S BYTES, the same squaring macro as
+ * actor_perception.c's actor_perception_distance_squared (owner ruling
+ * 2026-09-20). It is not attested in any surviving header or source.
+ * January's actor_action_handle_vehicle_entry squares prop->distance with
+ * the fmul issued before the best_vehicle_index store. Measured with the
+ * rest of the function held constant:
+ *
+ *     prop->distance * prop->distance              residual
+ *     (prop->distance * prop->distance)            residual
+ *     (real)prop->distance * (real)prop->distance  residual
+ *     (prop->distance) * prop->distance            residual, loads not CSE'd
+ *     ((prop->distance) * (prop->distance))        EXACT
+ *
+ * A parenthesis around one operand defeats VC7's load CSE, so January's two
+ * operands carried the same wrapper: one macro argument substituted twice.
+ * Every other square in this file is byte-identical in either spelling. */
+#define actor_action_distance_squared(distance) \
+	((distance) * (distance))
+
 /* ---------- structures */
 
 /* The fields used here from the 0x74-byte scenario conversation record. */
@@ -4114,7 +4133,7 @@ boolean actor_action_handle_vehicle_entry(
 							distance_squared < best_distance_squared)
 						{
 							best_vehicle_index = prop->vehicle_index;
-							best_distance_squared = prop->distance * prop->distance;
+							best_distance_squared = actor_action_distance_squared(prop->distance);
 							attempt_distance = 8.0f;
 							continue_distance = 10.0f;
 						}
