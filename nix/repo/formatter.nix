# `nix fmt`: treefmt over the engine's Rust and Swift, the flake's Nix and
# the tools' Python. The old port (port/) and the decompilation (source/)
# keep the formatting they have.
{ inputs, cell }:
let
  pkgs = cell.pkgs;
  treefmt = inputs.treefmt-nix.lib.evalModule pkgs {
    projectRootFile = "flake.nix";
    programs.rustfmt = {
      enable = true;
      # (the toolchain's, the one cargo fmt runs)
      package = cell.toolchain.rust;
      edition = "2021";
      includes = [ "engine/**/*.rs" ];
    };
    programs.swift-format = {
      enable = true;
      includes = [ "engine/app/**/*.swift" ];
      # (generated by uniffi at each build)
      excludes = [
        "engine/app/Sources/opence_ffiFFI/**"
        "engine/app/Sources/OpenCEEngineCore/**"
      ];
    };
    programs.nixfmt.enable = true;
    # (its settings are ruff.toml's)
    programs.ruff-format = {
      enable = true;
      # (treefmt's `**` stands for one folder or more)
      includes = [
        "tools/*.py"
        "tools/**/*.py"
        "configure.py"
      ];
    };
  };
in
{
  # the treefmt that `nix fmt` runs
  default = treefmt.config.build.wrapper;
  # the tree, formatted or failed (a `nix flake check`)
  check = treefmt.config.build.check inputs.self;
  inherit (treefmt.config.build) programs;
}
