/* x32: x86-64 code with 32-bit pointers and longs (the macOS port's guest
ABI, see port/macos/README.md), with the Android guest's types
(port/android/guest/libc/arch/arm64_32) */
#define _Addr int
#define _Int64 long long
#define _Reg long long

#define __BYTE_ORDER 1234
#define __LONG_MAX 0x7fffffffL

#ifndef __cplusplus
#ifdef __WCHAR_TYPE__
TYPEDEF __WCHAR_TYPE__ wchar_t;
#else
TYPEDEF unsigned short wchar_t;
#endif
#endif
TYPEDEF unsigned wint_t;

/* 32-bit, as in the MSVC runtime the game was written against (it keeps
times in longs); the system call layer converts to the kernel's 64-bit
structures */
TYPEDEF long time_t;
TYPEDEF long suseconds_t;

TYPEDEF int blksize_t;
TYPEDEF unsigned int nlink_t;

TYPEDEF float float_t;
TYPEDEF double double_t;

TYPEDEF struct { long long __ll; long double __ld; } max_align_t;
