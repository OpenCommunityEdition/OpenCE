+def _overflow_snapshot(state):
+    """Return a proven OF expression before SAHF, or None for unknown OF."""
+    if not state: return None
+    kind, ops = state
+    if kind == "sahf_of": return "_sahf_of"
+    if kind == "cmp" and len(ops) == 2:
+        bits = (_operand_width(ops[0]) or _operand_width(ops[1]) or 4) * 8
+        return f"!!(((_fa ^ _fb) & (_fa ^ (_fa - _fb))) & 0x{1 << (bits - 1):X}u)"
+    if kind == "test": return "0"
+    if kind in ("rol", "ror", "rcl", "rcr", "shl", "shr", "shld", "shrd"):
+        condition = _make_condition("jo", kind, ops)
+        return condition[0] if condition else None
+    return None
+
