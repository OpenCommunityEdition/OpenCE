+    def supplies_zf(state):
+        kind, ops = state
+        return (kind in ("snapshot_zf", "snapshot_sz") or
+                snapshot_signature(state) is not None or
+                (kind == "dec" and len(ops) == 1) or
+                (kind == "sub" and len(ops) == 2))
+    if allow_zf and all(supplies_zf(state) for state in states):
+        return ("snapshot_zf", [])
+    return None
