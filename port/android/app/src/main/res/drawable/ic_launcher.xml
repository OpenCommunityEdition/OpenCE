<?xml version="1.0" encoding="utf-8"?>
<!-- A ring world seen edge-on: the hatched inner face on the left, the outer
face on the right. The band between the two rims is drawn with the rims wound
in opposite directions, so that it has holes where they overlap without an
even-odd rule (which clip paths lack), and the hatching is drawn as lines
(vector drawables have no patterns). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="960"
    android:viewportHeight="960">

    <!-- circular background -->
    <path android:fillColor="#262626"
        android:pathData="M0,480 a480,480 0 1,0 960,0 a480,480 0 1,0 -960,0 Z" />

    <!-- the ring, centred and enlarged 1.25 times: its centre (261,370) at (480,480) -->
    <group
        android:pivotX="261"
        android:pivotY="370"
        android:scaleX="1.25"
        android:scaleY="1.25"
        android:translateX="219"
        android:translateY="110">

        <!-- inner face (left crescent): hatched -->
        <group>
            <clip-path android:pathData="M0,0 h261 v758 h-261 Z" />
            <path android:fillColor="#1a5b93" android:fillAlpha="0.75"
                android:pathData="M85,370 a156,350 0 1,0 312,0 a156,350 0 1,0 -312,0 Z M125,370 a156,350 0 1,1 312,0 a156,350 0 1,1 -312,0 Z" />
            <group>
                <clip-path android:pathData="M85,370 a156,350 0 1,0 312,0 a156,350 0 1,0 -312,0 Z M125,370 a156,350 0 1,1 312,0 a156,350 0 1,1 -312,0 Z" />
                <path android:strokeColor="#2f96e6" android:strokeAlpha="0.6" android:strokeWidth="1"
                    android:pathData="M0,0.5 h488 M0,13.5 h488 M0,26.5 h488 M0,39.5 h488 M0,52.5 h488 M0,65.5 h488 M0,78.5 h488 M0,91.5 h488 M0,104.5 h488 M0,117.5 h488 M0,130.5 h488 M0,143.5 h488 M0,156.5 h488 M0,169.5 h488 M0,182.5 h488 M0,195.5 h488 M0,208.5 h488 M0,221.5 h488 M0,234.5 h488 M0,247.5 h488 M0,260.5 h488 M0,273.5 h488 M0,286.5 h488 M0,299.5 h488 M0,312.5 h488 M0,325.5 h488 M0,338.5 h488 M0,351.5 h488 M0,364.5 h488 M0,377.5 h488 M0,390.5 h488 M0,403.5 h488 M0,416.5 h488 M0,429.5 h488 M0,442.5 h488 M0,455.5 h488 M0,468.5 h488 M0,481.5 h488 M0,494.5 h488 M0,507.5 h488 M0,520.5 h488 M0,533.5 h488 M0,546.5 h488 M0,559.5 h488 M0,572.5 h488 M0,585.5 h488 M0,598.5 h488 M0,611.5 h488 M0,624.5 h488 M0,637.5 h488 M0,650.5 h488 M0,663.5 h488 M0,676.5 h488 M0,689.5 h488 M0,702.5 h488 M0,715.5 h488 M0,728.5 h488 M0,741.5 h488 M0,754.5 h488" />
                <path android:strokeColor="#2a8ad6" android:strokeAlpha="0.7" android:strokeWidth="1.2"
                    android:pathData="M93,370 a150,344 0 1,0 300,0 a150,344 0 1,0 -300,0 Z" />
            </group>
        </group>

        <!-- outer face (right crescent): shaded top to bottom -->
        <group>
            <clip-path android:pathData="M261,0 h227 v758 h-227 Z" />
            <path android:pathData="M85,370 a156,350 0 1,0 312,0 a156,350 0 1,0 -312,0 Z M125,370 a156,350 0 1,1 312,0 a156,350 0 1,1 -312,0 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="261"
                        android:startY="20"
                        android:endX="261"
                        android:endY="720">
                        <item android:offset="0" android:color="#1c6fb3" />
                        <item android:offset="0.45" android:color="#1b5484" />
                        <item android:offset="1" android:color="#1e3b57" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- rims -->
        <path android:strokeColor="#1a8ae0" android:strokeWidth="4.5"
            android:pathData="M85,370 a156,350 0 1,0 312,0 a156,350 0 1,0 -312,0 Z" />
        <path android:strokeColor="#1a8ae0" android:strokeWidth="4.5"
            android:pathData="M125,370 a156,350 0 1,0 312,0 a156,350 0 1,0 -312,0 Z" />
    </group>
</vector>
