<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>English</string>
	<key>CFBundleExecutable</key><string>PowerSpark</string>
	<key>CFBundleIconFile</key><string>PowerSpark</string>
	<key>CFBundleIdentifier</key><string>org.opence.PowerSpark</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>PowerSpark</string>
	<key>CFBundleDisplayName</key><string>PowerSpark</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleSignature</key><string>????</string>
	<key>CFBundleShortVersionString</key><string>@VERSION@</string>
	<key>CFBundleVersion</key><string>@BUILD@</string>
	<key>OpenCEBuildStage</key><string>alpha</string>
	<key>LSMinimumSystemVersion</key><string>10.4</string>
	<!-- halo:// invite links. Launch Services opens the bundle for one and
	     sends the URL as a GURL Apple event, which opence_launcher.c turns
	     into the data root's join_link.txt, where the game reads an
	     invite (port/linux/src/p2p.c). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key><string>OpenCE invite</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array><string>halo</string></array>
		</dict>
	</array>
	<key>NSHighResolutionCapable</key><false/>
</dict>
</plist>
