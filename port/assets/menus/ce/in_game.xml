<?xml version="1.0" encoding="UTF-8"?>
<!-- The port's SETTINGS in the game's pause menus (tools/port_settings.py) -->
<menus>
	<widget name="in_game/settings_button" text="SETTINGS" type="text" width="202" height="27" bitmap="ui\shell\bitmaps\menu_bkds" font="ui\large_ui" color="#FF2896FF" align="center" text_y="3" platform="desktop">
		<on event="a" open="in_game/settings_screen"/>
		<on event="start" open="in_game/settings_screen"/>
	</widget>
	<widget name="in_game/settings_screen" width="640" height="480" flags="pass_unhandled_to_focused_child pause_game" bitmap="ui\shell\bitmaps\semi_transparent_grey" platform="desktop">
		<on event="b" back="true"/>
		<on event="back" back="true"/>
		<child widget="in_game/settings_box" x="210" y="164"/>
		<child widget="in_game/settings_list" x="218" y="170"/>
		<child widget="ui\shell\main_menu\button_key_sm" x="235" y="298"/>
	</widget>
	<widget name="in_game/settings_box" width="226" height="154" platform="desktop">
		<child widget="ui\shell\solo_game\pause_game\pausebox2_left" x="-4"/>
		<child widget="ui\shell\solo_game\pause_game\pausebox2_left_center" x="12"/>
		<child widget="ui\shell\solo_game\pause_game\pausebox2_right" x="206"/>
	</widget>
	<widget name="in_game/settings_list" type="column_list" width="202" height="119" flags="pass_unhandled_to_focused_child up_down_tabs_items" platform="desktop">
		<child widget="in_game/controls_setup_button" y="0"/>
		<child widget="in_game/gamepads_button" y="23"/>
		<child widget="in_game/mouse_setup_button" y="46"/>
		<child widget="in_game/audio_setup_button" y="69"/>
		<child widget="in_game/video_setup_button" y="92"/>
	</widget>
	<widget name="in_game/controls_setup_button" string_list="main_menu/settings_select/player_setup/player_profile_edit/profile_edit_options" string_index="1" type="text" width="202" height="27" bitmap="ui\shell\bitmaps\menu_bkds" font="ui\large_ui" color="#FF2896FF" align="center" text_y="3" platform="desktop">
		<on event="a" open="in_game/controls_setup_screen"/>
		<on event="start" open="in_game/controls_setup_screen"/>
	</widget>
	<widget name="in_game/controls_setup_screen" width="640" height="480" flags="pass_unhandled_to_focused_child" bitmap="ui\shell\bitmaps\semi_transparent_grey" platform="desktop">
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/controls_setup/controls_settings_screen"/>
	</widget>
	<widget name="in_game/gamepads_button" string_list="main_menu/settings_select/player_setup/player_profile_edit/profile_edit_options" string_index="2" type="text" width="202" height="27" bitmap="ui\shell\bitmaps\menu_bkds" font="ui\large_ui" color="#FF2896FF" align="center" text_y="3" platform="desktop">
		<on event="a" run="port active profile edit begin" open="in_game/gamepads_screen"/>
		<on event="start" run="port active profile edit begin" open="in_game/gamepads_screen"/>
	</widget>
	<widget name="in_game/gamepads_screen" width="640" height="480" flags="pass_unhandled_to_focused_child" bitmap="ui\shell\bitmaps\semi_transparent_grey" platform="desktop">
		<on event="deleted" run="port active profile edit end"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/gamepad_setup/gamepad_setup_screen"/>
	</widget>
	<widget name="in_game/mouse_setup_button" string_list="main_menu/settings_select/player_setup/player_profile_edit/profile_edit_options" string_index="3" type="text" width="202" height="27" bitmap="ui\shell\bitmaps\menu_bkds" font="ui\large_ui" color="#FF2896FF" align="center" text_y="3" platform="desktop">
		<on event="a" open="in_game/mouse_setup_screen"/>
		<on event="start" open="in_game/mouse_setup_screen"/>
	</widget>
	<widget name="in_game/mouse_setup_screen" width="640" height="480" flags="pass_unhandled_to_focused_child" bitmap="ui\shell\bitmaps\semi_transparent_grey" platform="desktop">
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/mouse_settings/mouse_settings_screen"/>
	</widget>
	<widget name="in_game/audio_setup_button" string_list="main_menu/settings_select/player_setup/player_profile_edit/profile_edit_options" string_index="4" type="text" width="202" height="27" bitmap="ui\shell\bitmaps\menu_bkds" font="ui\large_ui" color="#FF2896FF" align="center" text_y="3" platform="desktop">
		<on event="a" open="in_game/audio_setup_screen"/>
		<on event="start" open="in_game/audio_setup_screen"/>
	</widget>
	<widget name="in_game/audio_setup_screen" width="640" height="480" flags="pass_unhandled_to_focused_child" bitmap="ui\shell\bitmaps\semi_transparent_grey" platform="desktop">
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/audio_settings/audio_settings_screen"/>
	</widget>
	<widget name="in_game/video_setup_button" string_list="main_menu/settings_select/player_setup/player_profile_edit/profile_edit_options" string_index="5" type="text" width="202" height="27" bitmap="ui\shell\bitmaps\menu_bkds" font="ui\large_ui" color="#FF2896FF" align="center" text_y="3" platform="desktop">
		<on event="a" open="in_game/video_setup_screen"/>
		<on event="start" open="in_game/video_setup_screen"/>
	</widget>
	<widget name="in_game/video_setup_screen" width="640" height="480" flags="pass_unhandled_to_focused_child" bitmap="ui\shell\bitmaps\semi_transparent_grey" platform="desktop">
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/video_settings/video_settings_screen"/>
	</widget>
</menus>
