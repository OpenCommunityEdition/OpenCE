	<strings name="main_menu/settings_select/player_setup/player_profile_edit/vr_controls/help_strings">
		<string text=""/>
		<string text="Aiming with the controller, your hands: with arms\nfrom the shoulders, floating, or the game's arms."/>
		<string text="What aims: the right controller, which holds the\nweapon, your head, or a gamepad's right stick."/>
		<string text="With a gamepad, the right stick turns and\npitches the view, only turns it, or in steps."/>
		<string text="The left grip holds a long gun by its foregrip:\nit aims along the line between your hands."/>
		<string text="A punch of the right controller melees, as B does."/>
		<string text="How the right stick turns you: in steps, or\ncontinuously."/>
		<string text="How far each snap turn turns you."/>
		<string text="How fast smooth turning turns you, the stick\npushed all the way: degrees a second."/>
		<string text="In a vehicle's seat, the view from your head, or\nthe game's camera following the vehicle."/>
		<string text="Your height, the world's scale, the HUD, the\nmenus and the headset's resolution."/>
	</strings>
