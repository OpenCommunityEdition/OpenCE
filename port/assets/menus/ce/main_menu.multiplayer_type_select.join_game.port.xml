<?xml version="1.0" encoding="UTF-8"?>
<!-- The port's multiplayer screens, in the PC version's style (tools/port_settings.py) -->
<menus>
	<widget name="main_menu/multiplayer_type_select/join_game/password/password_screen" width="640" height="480" flags="pass_unhandled_to_focused_child pause_game" bitmap="bitmaps/gradient">
		<on event="b" run="port password back"/>
		<on event="back" run="port password back"/>
		<child widget="main_menu/multiplayer_type_select/join_game/password/header_password"/>
		<child widget="main_menu/multiplayer_type_select/join_game/password/options_menu"/>
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/password/header_password" controller="1" left="35" top="11" width="605" height="59" bitmap="main_menu/multiplayer_type_select/join_game/header_password">
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/password/help" type="text" controller="1" left="68" top="120" width="482" height="60" string_list="main_menu/multiplayer_type_select/join_game/password/help_strings" font="ui\large_ui" color="#FFFFFFFF">
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/password/options_menu" type="column_list" width="640" height="480" flags="pass_unhandled_to_focused_child up_down_tabs_children" description="main_menu/multiplayer_type_select/join_game/password/help">
		<data input="port password update"/>
		<on event="created" run="port password init"/>
		<child widget="main_menu/multiplayer_type_select/join_game/password/op_password" x="54" y="73"/>
		<child widget="main_menu/multiplayer_type_select/join_game/password/button_bar" y="414"/>
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/password/button_bar" type="column_list" width="640" height="28" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		
		<child widget="main_menu/multiplayer_type_select/join_game/password/button_ok" x="380" y="1"/>
		<child widget="common_button_cancel" x="510" y="1"/>
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/password/op_password" width="512" height="28" flags="pass_unhandled_to_focused_child" bitmap="bitmaps/option_bkds" color="#FF2896FF">
		<on event="a" run="port password edit"/>
		<on event="start" run="port password edit"/>
		<on event="b"/>
		<on event="back"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<child widget="main_menu/multiplayer_type_select/join_game/password/password_label"/>
		<child widget="main_menu/multiplayer_type_select/join_game/password/password_value" x="230" y="1"/>
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/password/password_label" type="text" controller="1" width="230" height="22" string_list="main_menu/multiplayer_type_select/join_game/password/labels" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="4">
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/password/password_value" type="text" controller="1" width="280" height="22" font="ui\small_ui" color="#FF2896FF" align="center" text_y="5" text_flags="no_focus_test">
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/password/button_defaults" type="text" width="128" height="24" bitmap="bitmaps/text_button_background" string_list="strings/common_button_captions" string_index="3" font="ui\small_ui" color="#FFFFFFFF" align="center" text_y="2">
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/password/button_ok" type="text" width="128" height="24" bitmap="bitmaps/text_button_background" text="JOIN GAME" font="ui\small_ui" color="#FFFFFFFF" align="center" text_y="2">
		<on event="a" run="port password join"/>
		<on event="start" run="port password join"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
	<strings name="main_menu/multiplayer_type_select/join_game/password/labels">
		<string text="PASSWORD:"/>
	</strings>
	<strings name="main_menu/multiplayer_type_select/join_game/password/help_strings">
		<string text=""/>
		<string text="This game has a password. Type it, then press\nEnter to join."/>
		<string text="That is not the game's password. Try again."/>
		<string text="Could not join the game."/>
	</strings>
	<widget name="main_menu/multiplayer_type_select/join_game/header_server_browser" controller="1" left="35" top="11" width="363" height="59" bitmap="main_menu/multiplayer_type_select/join_game/header_server_browser">
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/header_direct_link" controller="1" left="35" top="11" width="363" height="59" bitmap="main_menu/multiplayer_type_select/join_game/header_direct_link">
	</widget>
	<widget name="main_menu/multiplayer_type_select/join_game/button_clipboard" type="text" width="128" height="24" bitmap="bitmaps/text_button_background" text="PASTE LINK" font="ui\small_ui" color="#FFFFFFFF" align="center" text_y="2">
		<on event="a" run="direct ip connect go"/>
		<on event="start" run="direct ip connect go"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
</menus>
