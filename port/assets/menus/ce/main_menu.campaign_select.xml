		<child widget="main_menu/new_select/sel_list_desc_bkd"/>
		<child widget="main_menu/campaign_select/load_level_select_list"/>
		<child widget="main_menu/campaign_select/header_load_game"/>
	</widget>
	<widget name="main_menu/campaign_select/menu_item_back" type="text" width="256" height="33" bitmap="main_menu/campaign_select/item_back" string_list="main_menu/main_menu_options" font="ui\small_ui" color="#000080FF">
		<on event="a" back="true"/>
		<on event="start" back="true"/>
		<on event="left_mouse" back="true"/>
	</widget>
	<widget name="main_menu/campaign_select/menu_item_continue" type="text" width="256" height="33" bitmap="main_menu/campaign_select/item_continue" string_list="main_menu/main_menu_options" font="ui\small_ui" color="#000080FF">
		<on event="a" run="campaign menu continue"/>
