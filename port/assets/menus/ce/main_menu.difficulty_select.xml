		<data input="warn if diff will nuke saved game"/>
		<child widget="main_menu/difficulty_select/difficulty_select_list"/>
		<child widget="main_menu/difficulty_select/warning_message" x="65" y="215"/>
		<child widget="main_menu/difficulty_select/header_choose_difficulty"/>
