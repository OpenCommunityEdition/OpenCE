	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/dynamic_lighting/help_strings">
		<string text=""/>
		<string text="Plasma, grenades, rockets and flame streams cast\nsoft light on nearby surfaces and models."/>
		<string text="Weapon flashes light nearby surfaces, including\nWarthog and Scorpion guns. Stock effects remain."/>
		<string text="Swords, plasma charge/heat, fuel rods, Needler\nand AR screens. CUSTOM keeps individual choices."/>
		<string text="Jackal and stationary shields light surroundings.\nCUSTOM keeps individual choices."/>
		<string text="Engine glow and directional headlights illuminate\nvehicles and nearby surfaces."/>
		<string text="Visible powerups and teleporters cast soft light.\nStock effects and gameplay remain unchanged."/>
		<string text="Block projectile and emitter light behind walls.\nMuzzle and vehicle lights always use blocking."/>
		<string text="Shields light their surroundings as they flare.\nOnline: the host's choice."/>
		<string text="Light Show: three times as far, at full from a\nthird of the flare. Online: the host's choice."/>
	</strings>
