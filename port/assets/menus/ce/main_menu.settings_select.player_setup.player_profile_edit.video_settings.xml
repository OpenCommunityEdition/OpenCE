	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/help_strings">
		<string text=""/>
		<string text="Fullscreen takes the display; borderless covers it\nwith a window. F11 switches to the window."/>
		<string text="What fullscreen and borderless draw at. Fullscreen\nsets the display to it; borderless scales it."/>
		<string text="The window's size: 4:3, then 16:10, 16:9 and 21:9\n(its edges can also be dragged)."/>
		<string text="Native draws at the resolution; Original draws\nthe Xbox's 640x480 and scales it up."/>
		<string text="Wait for the display between frames, so that the\npicture never tears."/>
		<string text="With V-Sync off, the most frames a second. Auto:\ntwice the display's refresh rate."/>
		<string text="Draw a frame for every display refresh, blending\nbetween the game's 30 ticks a second."/>
		<string text="In first person, turn the view the moment the\nmouse moves, not up to two ticks later."/>
		<string text="Draw the HUD from the high-res redraws; off\ndraws the game's own pictures."/>
		<string text="Draw text and titles with high-res fonts; off\ndraws the game's own."/>
		<string text="Draw every model at this level of detail; Auto\nchooses by how large the model looks."/>
	</strings>
