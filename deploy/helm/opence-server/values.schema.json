{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "opence-server values",
  "description": "Strict where the chart defines the structure; free-form where values pass through to Kubernetes. values.yaml describes each value.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "volume": {
          "type": "object"
        },
        "subPath": {
          "type": "string"
        }
      }
    },
    "secretValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "gameData": {
      "$ref": "#/definitions/volume"
    },
    "customMaps": {
      "$ref": "#/definitions/volume"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 15,
          "pattern": "^[ -~]*$"
        },
        "rotation": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxPlayers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2,
          "maximum": 127
        },
        "public": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "lobbySeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 300
        },
        "motd": {
          "type": "string",
          "maxLength": 127
        },
        "logFormat": {
          "enum": [
            "",
            "text",
            "json",
            null
          ]
        },
        "instance": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{0,32}$"
        },
        "region": {
          "type": "string",
          "maxLength": 16
        },
        "masterPublish": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "password": {
          "$ref": "#/definitions/secretValue"
        }
      }
    },
    "publisherKey": {
      "$ref": "#/definitions/secretValue"
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "moderatorPassword": {
          "type": "string"
        },
        "moderatorKey": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "$ref": "#/definitions/port"
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tunnelPort": {
          "$ref": "#/definitions/port"
        },
        "publicAddress": {
          "type": "string"
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object"
        },
        "emptyDirSizeLimit": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "nodePort": {
          "type": [
            "string",
            "integer"
          ]
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        },
        "externalTrafficPolicy": {
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        },
        "loadBalancerClass": {
          "type": "string"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "strategy": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "from": {
          "type": "array"
        },
        "webFrom": {
          "type": "array"
        },
        "dns": {
          "type": "object"
        },
        "internet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidr": {
              "type": "string"
            },
            "except": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tcpPorts": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/port"
              }
            },
            "udp": {
              "type": "boolean"
            }
          }
        },
        "extraIngress": {
          "type": "array"
        },
        "extraEgress": {
          "type": "array"
        }
      }
    },
    "extraObjects": {
      "type": "array"
    }
  }
}
